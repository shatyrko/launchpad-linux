class AppItem:
    def __init__(self, info: Gio.AppInfo):
        self.info = info
        self.name = info.get_display_name() or info.get_name() or info.get_id() or "?"
        self.key = self.name.casefold()
        self.id = info.get_id() or self.name


def load_apps() -> list:
    seen, apps = set(), []
    for info in Gio.AppInfo.get_all():
        if not info.should_show():
            continue
        ident = info.get_id() or ""
        if ident.startswith(APP_ID) or ident in seen:
            continue
        seen.add(ident)
        apps.append(AppItem(info))
    apps.sort(key=lambda a: a.key)
    return apps


def icon_for(app: AppItem) -> Gio.Icon:
    return app.info.get_icon() or Gio.ThemedIcon.new("application-x-executable")


def make_icon(entry, icon: int) -> Gtk.Widget:
    """The picture of an app, or of a folder (a rounded square with up to nine small icons)."""
    if entry.kind == "folder":
        box = Gtk.Box()
        box.add_css_class("folder-icon")
        side = int(icon * 1.08)                    # a folder looks small next to full-bleed app icons
        box.set_size_request(side, side)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)          # stays square in a taller cell
        grid = Gtk.Grid()
        grid.set_row_homogeneous(True)
        grid.set_column_homogeneous(True)
        grid.set_hexpand(True)
        grid.set_vexpand(True)
        mini = max(16, int(icon * 0.31))
        for n, app in enumerate(entry.apps[:9]):
            img = Gtk.Image.new_from_gicon(icon_for(app))
            img.set_pixel_size(mini)
            grid.attach(img, n % 3, n // 3, 1, 1)
        box.append(grid)
        return box
    image = Gtk.Image.new_from_gicon(icon_for(entry.app))
    image.set_pixel_size(icon)
    image.set_halign(Gtk.Align.CENTER)
    return image


class Cell(Gtk.Box):
    """One app or folder in a grid: the picture over its name."""

    def __init__(self, entry, icon: int, width: int, height: int):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.entry = entry
        self.icon_px = icon
        self.add_css_class("cell")
        self.set_size_request(width, height)
        self.set_halign(Gtk.Align.CENTER)
        self.set_valign(Gtk.Align.CENTER)
        slot = Gtk.Box()                           # the same height for apps and folders: the names share one baseline
        slot.set_size_request(-1, int(icon * 1.08))
        picture = make_icon(entry, icon)
        picture.set_hexpand(True)
        picture.set_halign(Gtk.Align.CENTER)
        picture.set_valign(Gtk.Align.CENTER)
        picture.set_vexpand(True)
        slot.append(picture)
        self.append(slot)
        label = Gtk.Label(label=entry.name)
        label.add_css_class("name")
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.set_max_width_chars(18)
        label.set_lines(1)
        label.set_halign(Gtk.Align.CENTER)
        self.append(label)


def ancestor(widget, kind):
    while widget is not None and not isinstance(widget, kind):
        widget = widget.get_parent()
    return widget


def has_class(widget, css):
    while widget is not None:
        if widget.has_css_class(css):
            return True
        widget = widget.get_parent()
    return False


