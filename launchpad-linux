def load_palette() -> dict:
    """The colours of the palette Noctalia is using now (dark or light), else the fallback."""
    theme = {}
    for path in ("~/.config/noctalia/config.toml", "~/.local/state/noctalia/settings.toml"):   # the second wins
        try:
            with open(os.path.expanduser(path), "rb") as f:
                theme.update(tomllib.load(f).get("theme", {}))
        except (OSError, tomllib.TOMLDecodeError):
            pass
    mode = theme.get("shell_mode") or theme.get("mode") or "dark"
    source = theme.get("source", "community")
    candidates = []
    if source == "community" and theme.get("community_palette"):
        candidates.append(f"~/.local/state/noctalia/community-palettes/{urllib.parse.quote(theme['community_palette'])}.json")
    if theme.get("custom_palette"):
        candidates.append(f"~/.config/noctalia/palettes/{theme['custom_palette']}.json")
    for path in candidates:
        try:
            with open(os.path.expanduser(path)) as f:
                colors = json.load(f).get(mode)
            if isinstance(colors, dict):
                return {**FALLBACK, **{k: v for k, v in colors.items() if isinstance(v, str)}}
        except (OSError, ValueError):
            continue
    return dict(FALLBACK)


def rgba(hex_color: str, alpha: float) -> str:
    h = hex_color.lstrip("#")
    return f"rgba({int(h[0:2], 16)}, {int(h[2:4], 16)}, {int(h[4:6], 16)}, {alpha})"


